---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | escape }}</title>
  <subtitle>{{ site.description | escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/' | absolute_url }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.author | escape }}</name></author>
  {% assign articles = site.articles | sort: 'date' | reverse %}
  {% for article in articles limit: 20 %}
  <entry>
    <title>{{ article.title | escape }}</title>
    <link href="{{ article.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ article.url | absolute_url }}</id>
    <published>{{ article.date | date_to_xmlschema }}</published>
    <updated>{{ article.date | date_to_xmlschema }}</updated>
    {% if article.summary %}<summary>{{ article.summary | escape }}</summary>{% endif %}
    <content type="html">{{ article.content | strip_newlines | escape }}</content>
  </entry>
  {% endfor %}
</feed>
